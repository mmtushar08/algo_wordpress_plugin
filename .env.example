# ─────────────────────────────────────────────────────────────────────────────
# AlgoTrader India — environment variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram alerts ───────────────────────────────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token below
# Step 2: Message @userinfobot on Telegram → copy your numeric chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCDefgh_your_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# ── Trading parameters ────────────────────────────────────────────────────────
DEFAULT_TICKER=NIFTY
DEFAULT_EXPIRY=weekly
DEFAULT_CAPITAL=100000

# Risk controls (INR) — engine stops placing orders if limits are hit
MAX_DAILY_LOSS=5000
MAX_POSITION_SIZE=25000

# Safety switch — paper mode is ON by default (no real money at risk)
# Set to false only after you have integrated a broker SDK in
# execution/order_manager.py and verified signals for several days.
PAPER_TRADING=true

# ── Live broker SDK (optional) ────────────────────────────────────────────────
# Uncomment and fill in whichever broker you use.
# Then update execution/order_manager.py with the corresponding SDK calls.
#
# Zerodha Kite Connect  (pip install kiteconnect)
# BROKER=zerodha
# KITE_API_KEY=your_key
# KITE_ACCESS_TOKEN=your_token
#
# Upstox  (pip install upstox-python-sdk)  — free with Upstox account
# BROKER=upstox
# UPSTOX_API_KEY=your_key
# UPSTOX_ACCESS_TOKEN=your_token
#
# Fyers  (pip install fyers-apiv3)  — free with Fyers account
# BROKER=fyers
# FYERS_CLIENT_ID=your_client_id
# FYERS_ACCESS_TOKEN=your_token
#
# ICICI Breeze  (pip install breeze-connect)  — free with ICICI Direct account
# BROKER=breeze
# BREEZE_API_KEY=your_key
# BREEZE_API_SECRET=your_secret
# BREEZE_SESSION_TOKEN=your_token
