# ─────────────────────────────────────────────────────────────────────────────
# AlgoTrader India — environment variables template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Angel One SmartAPI ────────────────────────────────────────────────────────
# Sign up at https://smartapi.angelbroking.com/ to get these credentials.
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_angel_one_client_id
ANGEL_PASSWORD=your_angel_one_password
ANGEL_TOTP_TOKEN=your_totp_secret_key   # 16-char base32 secret from Angel One 2FA setup

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token below
# 2. Message @userinfobot to get your chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCDefgh_your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Trading parameters ────────────────────────────────────────────────────────
DEFAULT_TICKER=NIFTY
DEFAULT_EXPIRY=weekly
DEFAULT_CAPITAL=100000

# Risk limits (INR)
MAX_DAILY_LOSS=5000
MAX_POSITION_SIZE=25000

# Safety switch — set to false ONLY when you are ready for live trading
PAPER_TRADING=true
